PORT=3000
APP_SECRET=local-agent-only

# ADSPower local neste computador.
# Porta fixa da API local usada pelo NinjaFlix.
ADSPOWER_BASE_URL=http://127.0.0.1:50326
ADSPOWER_PROFILE_ID=
ADSPOWER_OPEN_TABS=0
ADSPOWER_IP_TAB=0
ADSPOWER_DISABLE_PASSWORD_FILLING=0
ADSPOWER_ENABLE_PASSWORD_SAVING=1
ADSPOWER_CLEAR_CACHE_AFTER_CLOSING=0

# Agente cliente local.
AGENT_HOST=127.0.0.1
AGENT_PORT=3101

# Portal/admin central na VPS. Manter HTTPS.
PORTAL_URL=https://agente-admin.187.77.55.247.nip.io

# Normalmente pode ficar vazio: o login por CPF cria/renova o token automaticamente.
AGENT_TOKEN=

# Cache curto para evitar rate limit no ADSPower ao listar perfis detectados.
ADSPOWER_PROFILES_CACHE_TTL_MS=30000
